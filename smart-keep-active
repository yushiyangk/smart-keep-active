#!/usr/bin/env bash


SMARTMONTOOLS_UNIT='smartmontools.service'
CHECK_INTERVAL_SEC=600
ACTIVE_INTERVAL_SEC=300
READ_BYTES=256


keep_active_tmp="$(mktemp --tmpdir=/tmp --directory .smart-keep-active.XXXXXXXXXX)"
echo "Temp directory: $keep_active_tmp"

keep_active() {
	dev="$1"
	if [ ! -b "$dev" ]; then
		echo "keep_active: $dev is not a block device; ignoring" >&2
		return 1
	fi
	selftest="$2"
	if [ -z "$selftest" ]; then
		selftest="self-test"
	fi

	devrealpath="$(realpath "$dev")"
	if [ "$devrealpath" = "$dev" ]; then
		devlabel="$devrealpath"
	else
		devlabel="$devrealpath ($dev)"
	fi

	devname="$(basename "$devrealpath")"
	i=0
	while [ -e "$keep_active_tmp/$devname.$i" ]; do
		if [ "$(readlink "tmp_dir/$devname.$i")" = "$devrealpath" ]; then
			echo "keep_active: $devlabel already being kept active (lockfile $keep_active_tmp/$devname.$i)"
			return 0
		fi
		i=$((i + 1))
	done

	lockfile="$keep_active_tmp/$devname.$i"
	pidfile="$keep_active_tmp/$devname.$i.pid"
	trap 'trap "" INT TERM HUP; flock "$keep_active_tmp/lock" rm -f "$lockfile" "$pidfile"; echo "keep_active: $devlabel terminated"; exit' INT TERM HUP

	{
		flock 3
		ln -s "$devrealpath" "$lockfile"
		echo "$BASHPID" > "$pidfile"
	} 3> "$keep_active_tmp/lock"

	while smartctl -n standby --capabilities "$dev" 2> /dev/null | grep -q "Self-test routine in progress"; do
		head --bytes="$READ_BYTES" "$dev" > /dev/null 2> /dev/null
		sleep "$ACTIVE_INTERVAL_SEC" &
		wait $!
	done

	flock "$keep_active_tmp/lock" rm "$lockfile" "$pidfile"
	echo "keep_active: $devlabel $selftest completed"
}

cleanup_keep_active() {
	{
		flock 3
		pidfiles=("$keep_active_tmp"/*.pid)
	} 3> "$keep_active_tmp/lock"
	for pidfile in "${pidfiles[@]}"; do
		pid="$(cat "$pidfile" 2> /dev/null || echo '')"
		if [ -n "$pid" ]; then
			kill "$pid" 2> /dev/null
			# Wait for process to exit
			tail --pid="$pid" -f /dev/null 2>/dev/null
		fi
	done
}

monitor_disks() {
	echo "monitor_disks: started"

	while true; do
		lsblk --nodeps --noheadings --output=PATH,TYPE,ROTA | while read -r dev devtype devrota; do
			if [ "$devtype" = "disk" ] && [ "$devrota" = "1" ]; then
				if [ ! -b "$dev" ]; then
					echo "monitor_disks: $dev is not a block device; ignoring" >&2
					continue
				fi

				if smartctl -n standby --capabilities "$dev" 2> /dev/null | grep -q "Self-test routine in progress"; then
					devrealpath="$(realpath "$dev")"
					if [ "$devrealpath" = "$dev" ]; then
						devlabel="$devrealpath"
					else
						devlabel="$devrealpath ($dev)"
					fi

					active=0

					devname="$(basename "$devrealpath")"
					i=0
					while [ -e "$keep_active_tmp/$devname.$i" ]; do
						if [ "$(readlink "tmp_dir/$devname.$i")" = "$devrealpath" ]; then
							active=1
							break
						fi
						i=$((i + 1))
					done

					if [ "$active" -eq 1 ]; then
						echo "monitor_disks: $devlabel already being kept active (lockfile $keep_active_tmp/$devname.$i)"
						continue
					else
						echo "monitor_disks: $devlabel self-test detected"
						keep_active "$dev" &
					fi
				fi
			fi
		done
		sleep "$CHECK_INTERVAL_SEC" &
		wait $!
	done
}

monitor_disks &
monitor_pid=$!

trap 'trap "" INT TERM HUP; kill "$monitor_pid" 2> /dev/null; cleanup_keep_active; exit' INT TERM HUP


while read -r line; do
	case "$line" in
		*Device:\ *\ starting\ scheduled\ *Self-Test*)
			selftest="$(echo "$line" | sed 's/^Device: *.*starting scheduled //' | sed 's/\.$//')"
			dev="$(echo "$line" | sed 's/^Device: *//' | sed 's/ *\[.\+\], *starting scheduled .*Self-Test.*$//')"
			devrealpath="$(realpath "$dev")"
			if [ "$devrealpath" = "$dev" ]; then
				echo "$devrealpath $selftest started by smartmontools"
			else
				echo "$devrealpath ($dev) $selftest started by smartmontools"
			fi
			keep_active "$dev" "$selftest" &
			;;
	esac
done < <(journalctl --unit="$SMARTMONTOOLS_UNIT" --follow --boot --output=cat)

kill "$monitor_pid" 2> /dev/null
cleanup_keep_active
